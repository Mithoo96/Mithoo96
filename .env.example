# ai-router configuration. Copy to ~/.config/ai-router/.env (the installer does
# this with chmod 600) and fill in only the providers you have legitimately
# signed up for. Never commit a filled-in copy: .env is in .gitignore.
# Real environment variables always win over values in this file.

# --- Providers (leave blank to disable) --------------------------------------

# Anthropic API key from console.anthropic.com (pay-as-you-go).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5

# Use your Claude subscription through the Claude Code CLI (`claude -p`).
# Counts against your plan's normal usage limits. 1 = enabled.
AI_ENABLE_CLAUDE_CLI=0
# CLAUDE_CLI_MODELS=sonnet,opus

# OpenRouter key from openrouter.ai/keys. Only models ending in ":free" are
# treated as zero-cost; run `ai models --refresh` to discover the current list.
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-coder:free

# Google AI Studio key from aistudio.google.com/apikey (free tier).
# Note: Google may use free-tier prompts to improve its products. Don't send
# confidential code there; use GEMINI_TIER=cheap if you enabled billing.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.5-pro

# Groq key from console.groq.com/keys (free tier).
GROQ_API_KEY=
# GROQ_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-120b

# GitHub Models: a fine-grained personal access token with the "models: read"
# permission. Deliberately separate from GITHUB_TOKEN so a broad repo token is
# never sent to an inference endpoint by accident.
GITHUB_MODELS_TOKEN=
# GITHUB_MODELS=openai/gpt-4.1-mini,openai/gpt-4.1

# Ollama (local). Detected automatically when running.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODELS=qwen2.5-coder:7b,llama3.2:3b   # restrict to these
# AI_OLLAMA_CONTEXT=8192
# AI_ENABLE_OLLAMA=1

# Other OpenAI-compatible providers you explicitly configure, e.g. "together":
# AI_CUSTOM_PROVIDERS=together
# AI_CUSTOM_TOGETHER_BASE_URL=https://api.together.xyz/v1
# AI_CUSTOM_TOGETHER_API_KEY_ENV=TOGETHER_API_KEY    # name of the variable, not the key
# AI_CUSTOM_TOGETHER_MODELS=Qwen/Qwen2.5-Coder-32B-Instruct
# AI_CUSTOM_TOGETHER_TIER=cheap                      # local | free | cheap | premium
# AI_CUSTOM_TOGETHER_COST_IN=0.80                    # USD per 1M input tokens
# AI_CUSTOM_TOGETHER_COST_OUT=0.80
# AI_CUSTOM_TOGETHER_CONTEXT=32768
# TOGETHER_API_KEY=

# --- Tier overrides (if you upgraded an account to paid) ----------------------
# GROQ_TIER=cheap
# AI_PRICE_GROQ__LLAMA_3_3_70B_VERSATILE=0.59,0.79   # in,out USD per 1M tokens

# --- Spending guards -----------------------------------------------------------
# Stop using paid models once today's tracked spend reaches this (0 = off).
AI_DAILY_BUDGET_USD=0
# Skip any model whose estimated cost for one request exceeds this (0 = off).
AI_MAX_COST_PER_REQUEST_USD=0
# AI_DISABLED_PROVIDERS=github,openrouter

# --- Reliability ----------------------------------------------------------------
# AI_MAX_TOKENS=4096
# AI_REQUEST_TIMEOUT=120
# AI_MAX_RETRIES=2                 # retries for 5xx/timeouts only, never for 429
# AI_BACKOFF_BASE=1                # seconds, doubled each retry, with jitter
# AI_BACKOFF_MAX=30
# AI_RATE_LIMIT_COOLDOWN=60        # used when a 429 carries no Retry-After
# AI_QUOTA_COOLDOWN=3600
# AI_AUTH_COOLDOWN=1800
# AI_UNAVAILABLE_COOLDOWN=120
# AI_ROUTER_HOME=~/.local/share/ai-router
