# ─────────────────────────────────────────────────────────────
# Mithoo Media Group — server configuration
# Copy to .env (never commit .env). All secrets live ONLY on the server.
# ─────────────────────────────────────────────────────────────

# Public base URL used for canonical links, sitemap and hreflang (no trailing slash)
SITE_URL=https://mithoomediagroup.com
PORT=8080
NODE_ENV=production
# Set to the number of reverse proxies in front of the app (e.g. 1 behind Render/Nginx)
# so client IPs for rate limiting are read from X-Forwarded-For correctly.
TRUST_PROXY_HOPS=1

# Where submissions are kept if the CRM is unreachable (must be writable, outside web root)
DATA_DIR=./data

# ── GoHighLevel (LeadConnector) ────────────────────────────────
# Create a Private Integration in the Mithoo Media Group sub-account:
# Settings → Private Integrations → scopes: contacts.write, contacts.readonly,
# opportunities.write, opportunities.readonly, locations/customFields.readonly
GHL_ENABLED=true
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=7YAqeIgL5dKqfWiT7NUN
# Fill after creating the "MMG Sales" pipeline in GHL (Opportunities → Pipelines)
GHL_PIPELINE_ID=
GHL_STAGE_NEW_LEAD_ID=
# Optional: GHL user id that receives follow-up tasks
GHL_ASSIGNED_USER_ID=
# Optional: link to contact in GHL UI used in internal notifications
GHL_APP_BASE=https://app.gohighlevel.com

# ── Email (SMTP) ───────────────────────────────────────────────
# Used for the internal "new lead" notification (backup to the CRM) and,
# if enabled, the prospect confirmation. Use a transactional provider
# (Postmark, Amazon SES, Resend SMTP, Google Workspace SMTP relay…).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mithoo Media Group <info@mithoomediagroup.com>"
MAIL_REPLY_TO=info@mithoomediagroup.com
LEAD_NOTIFY_TO=info@mithoomediagroup.com
# Who sends the prospect confirmation email: "crm" (GHL workflow — recommended)
# or "app" (this server via SMTP). Never both, to avoid duplicates.
CONFIRMATION_SENDER=crm

# ── Spam protection ────────────────────────────────────────────
# Optional Cloudflare Turnstile (free). Leave empty to rely on honeypot + timing + rate limit.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_PER_HOUR=5

# ── Analytics (consent-gated, optional) ───────────────────────
GA4_MEASUREMENT_ID=

# ── Operations ─────────────────────────────────────────────────
# Protects GET /api/health/details (integration status). Long random string.
ADMIN_HEALTH_TOKEN=
# Days to retain fallback submissions after they were synced to the CRM
FALLBACK_RETENTION_DAYS=30
