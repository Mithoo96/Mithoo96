<section class="section section--{{ section.settings.background }}">
  <div class="page-width">
    <div class="section-heading section-heading--center" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <ul class="testimonials" role="list">
      {%- for block in section.blocks -%}
        <li class="testimonial" data-reveal style="--reveal-delay: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <figure>
            <div class="testimonial__stars" aria-label="{{ 'sections.testimonials.rating' | t: rating: block.settings.rating }}">
              {%- for i in (1..5) -%}
                <span aria-hidden="true" class="{% if i > block.settings.rating %}is-empty{% endif %}">&#9733;</span>
              {%- endfor -%}
            </div>
            <blockquote class="testimonial__quote">{{ block.settings.quote }}</blockquote>
            <figcaption class="testimonial__author">{{ block.settings.author | escape }}</figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "class": "section-testimonials",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.common.eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "t:sections.common.heading", "default": "What our customers say" },
    {
      "type": "select",
      "id": "background",
      "label": "t:sections.common.background",
      "options": [
        { "value": "default", "label": "t:sections.common.background_options.default" },
        { "value": "alt", "label": "t:sections.common.background_options.alt" },
        { "value": "accent", "label": "t:sections.common.background_options.accent" }
      ],
      "default": "alt"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.blocks.testimonial.name",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "t:sections.testimonials.blocks.testimonial.settings.quote.label", "default": "<p>My hands have never felt this soft. It absorbs instantly and the scent is divine.</p>" },
        { "type": "text", "id": "author", "label": "t:sections.testimonials.blocks.testimonial.settings.author.label", "default": "Customer name" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "t:sections.testimonials.blocks.testimonial.settings.rating.label", "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.name",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial", "settings": { "quote": "<p>My nails finally stopped breaking. This is now part of my daily ritual.</p>" } },
        { "type": "testimonial", "settings": { "quote": "<p>Feels like a spa treatment at home. Beautiful packaging, too.</p>" } }
      ]
    }
  ]
}
{% endschema %}
