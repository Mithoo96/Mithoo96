<section class="section section--{{ section.settings.background }}">
  <div class="page-width page-width--narrow rich-text" data-reveal>
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="rich-text__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "class": "section-rich-text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.common.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:sections.common.heading", "default": "Beauty begins with care" },
    { "type": "richtext", "id": "text", "label": "t:sections.common.text", "default": "<p>Share your brand's promise with your customers.</p>" },
    { "type": "text", "id": "button_label", "label": "t:sections.common.button_label" },
    { "type": "url", "id": "button_link", "label": "t:sections.common.button_link" },
    {
      "type": "select",
      "id": "background",
      "label": "t:sections.common.background",
      "options": [
        { "value": "default", "label": "t:sections.common.background_options.default" },
        { "value": "alt", "label": "t:sections.common.background_options.alt" },
        { "value": "accent", "label": "t:sections.common.background_options.accent" }
      ],
      "default": "default"
    }
  ],
  "presets": [{ "name": "t:sections.rich_text.name" }]
}
{% endschema %}
