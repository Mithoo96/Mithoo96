{%- if section.settings.text != blank -%}
  <div class="announcement-bar" {{ section.shopify_attributes }}>
    <div class="page-width">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement-bar__link">{{ section.settings.text | escape }}</a>
      {%- else -%}
        <p class="announcement-bar__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "class": "section-announcement-bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.announcement_bar.settings.text.label",
      "default": "Complimentary shipping on orders over $50"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.announcement_bar.settings.link.label"
    }
  ],
  "presets": [{ "name": "t:sections.announcement_bar.name" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
