<section class="section section--{{ section.settings.background }}">
  <div class="page-width page-width--narrow newsletter" data-reveal>
    {%- if section.settings.heading != blank -%}
      <h2 class="newsletter__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'customer', id: 'NewsletterForm', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form__field">
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
        <input
          id="NewsletterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          class="input"
          placeholder="{{ 'newsletter.label' | t }}"
          autocomplete="email"
          required
        >
        <button type="submit" class="button">{{ 'newsletter.button' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="form-message form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.common.heading", "default": "Receive 10% off your first order" },
    { "type": "richtext", "id": "text", "label": "t:sections.common.text", "default": "<p>Be the first to know about new rituals, exclusive offers and hand care tips.</p>" },
    {
      "type": "select",
      "id": "background",
      "label": "t:sections.common.background",
      "options": [
        { "value": "default", "label": "t:sections.common.background_options.default" },
        { "value": "alt", "label": "t:sections.common.background_options.alt" },
        { "value": "accent", "label": "t:sections.common.background_options.accent" }
      ],
      "default": "accent"
    }
  ],
  "presets": [{ "name": "t:sections.newsletter.name" }]
}
{% endschema %}
