{%- paginate blog.articles by 9 -%}
  <section class="section">
    <div class="page-width">
      <h1 class="page__title">{{ blog.title | escape }}</h1>
      <ul class="article-grid" role="list">
        {%- for article in blog.articles -%}
          <li data-reveal>
            <a href="{{ article.url }}" class="article-card">
              <div class="article-card__media">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 900 | image_tag: widths: '375, 550, 750, 900', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy' }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </div>
              <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
              <h2 class="article-card__title">{{ article.title | escape }}</h2>
              <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "class": "section-main-blog"
}
{% endschema %}
