{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign product_form_id = 'product-form-' | append: section.id
-%}

<section class="section product-section">
  <div class="page-width">
    <product-info class="product" data-section="{{ section.id }}" data-url="{{ product.url }}">
      <div class="product__media">
        {%- if product.media.size > 0 -%}
          <ul class="product__gallery" role="list">
            {%- if featured_media -%}
              <li class="product__media-item" data-media-id="{{ featured_media.id }}">
                {% render 'product-media', media: featured_media, loading: 'eager' %}
              </li>
            {%- endif -%}
            {%- for media in product.media -%}
              {%- unless media.id == featured_media.id -%}
                <li class="product__media-item" data-media-id="{{ media.id }}">
                  {% render 'product-media', media: media, loading: 'lazy' %}
                </li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="product__media-item">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div>
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'vendor' -%}
              <p class="eyebrow" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>

            {%- when 'title' -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

            {%- when 'price' -%}
              <div class="product__price" data-price {{ block.shopify_attributes }}>
                {% render 'price', product: product, variant: current_variant %}
              </div>
              {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                <p class="product__tax">
                  {%- if cart.taxes_included -%}{{ 'products.product.include_taxes' | t }}{%- endif -%}
                  {%- if shop.shipping_policy.body != blank -%}
                    {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- endif -%}
                </p>
              {%- endif -%}

            {%- when 'text' -%}
              <div class="product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="variant-picker" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="variant-picker__option">
                      <legend class="variant-picker__label">
                        {{ option.name }}: <span data-option-value="{{ forloop.index0 }}">{{ option.selected_value }}</span>
                      </legend>
                      <div class="variant-picker__values">
                        {%- for value in option.values -%}
                          <input
                            type="radio"
                            id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                            name="{{ option.name | escape }}"
                            value="{{ value | escape }}"
                            form="{{ product_form_id }}"
                            data-option-index="{{ option.position | minus: 1 }}"
                            {% if option.selected_value == value %}checked{% endif %}
                          >
                          <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}" class="variant-picker__pill">
                            {{- value -}}
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  <script type="application/json" data-variants>
                    {{ product.variants | json }}
                  </script>
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div class="product__buy" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: product_form_id, class: 'product-form', novalidate: 'novalidate', data-product-form: '' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

                  <div class="product-form__row">
                    <div class="quantity">
                      <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                      <button type="button" class="quantity__button" data-quantity-minus aria-label="{{ 'products.product.quantity_decrease' | t }}">&minus;</button>
                      <input id="Quantity-{{ section.id }}" class="quantity__input" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                      <button type="button" class="quantity__button" data-quantity-plus aria-label="{{ 'products.product.quantity_increase' | t }}">+</button>
                    </div>

                    <button
                      type="submit"
                      name="add"
                      class="button button--full product-form__submit"
                      data-add-to-cart
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      <span data-add-to-cart-text>
                        {%- if current_variant.available -%}
                          {{ 'products.product.add_to_cart' | t }}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </span>
                    </button>
                  </div>

                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}

                  <p class="form-message form-message--error" data-form-error hidden></p>
                {%- endform -%}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}

            {%- when 'collapsible_tab' -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary class="accordion__summary">
                  <span>{{ block.settings.heading | escape }}</span>
                  <span class="accordion__icon" aria-hidden="true"></span>
                </summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}
                    {{ block.settings.page.content }}
                  {%- endif -%}
                </div>
              </details>

            {%- when 'share' -%}
              <div class="product__share" {{ block.shopify_attributes }}>
                <button type="button" class="link-button" data-share data-url="{{ request.origin }}{{ product.url }}" data-title="{{ product.title | escape }}">
                  {{ 'products.product.share' | t }}
                </button>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </product-info>
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "t:sections.main_product.blocks.vendor.name", "limit": 1 },
    { "type": "title", "name": "t:sections.main_product.blocks.title.name", "limit": 1 },
    { "type": "price", "name": "t:sections.main_product.blocks.price.name", "limit": 1 },
    {
      "type": "text",
      "name": "t:sections.main_product.blocks.text.name",
      "settings": [
        { "type": "richtext", "id": "text", "label": "t:sections.common.text", "default": "<p>Text block</p>" }
      ]
    },
    { "type": "variant_picker", "name": "t:sections.main_product.blocks.variant_picker.name", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "t:sections.main_product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
          "default": true
        }
      ]
    },
    { "type": "description", "name": "t:sections.main_product.blocks.description.name", "limit": 1 },
    {
      "type": "collapsible_tab",
      "name": "t:sections.main_product.blocks.collapsible_tab.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.common.heading", "default": "Ingredients" },
        { "type": "richtext", "id": "content", "label": "t:sections.main_product.blocks.collapsible_tab.settings.content.label" },
        { "type": "page", "id": "page", "label": "t:sections.main_product.blocks.collapsible_tab.settings.page.label" }
      ]
    },
    { "type": "share", "name": "t:sections.main_product.blocks.share.name", "limit": 1 }
  ]
}
{% endschema %}
