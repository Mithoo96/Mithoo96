<section class="section section--{{ section.settings.background }}">
  <div class="page-width">
    <div class="image-with-text{% if section.settings.image_position == 'right' %} image-with-text--reverse{% endif %}">
      <div class="image-with-text__media" data-reveal="zoom">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1500
            | image_tag:
              widths: '375, 550, 750, 1100, 1500',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'lazy'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>

      <div class="image-with-text__content" data-reveal style="--reveal-delay: 1;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="image-with-text__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="button button--dark">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "class": "section-image-with-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:sections.common.image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.image_with_text.settings.image_position.label",
      "options": [
        { "value": "left", "label": "t:sections.image_with_text.settings.image_position.options.left" },
        { "value": "right", "label": "t:sections.image_with_text.settings.image_position.options.right" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow", "label": "t:sections.common.eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "t:sections.common.heading", "default": "Crafted with intention, made for real hands" },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.common.text",
      "default": "<p>Every Faroo formula blends nourishing butters, cold-pressed oils and vitamins to repair dryness, protect against daily wear and restore the natural beauty of your hands and nails.</p>"
    },
    { "type": "text", "id": "button_label", "label": "t:sections.common.button_label", "default": "Read our story" },
    { "type": "url", "id": "button_link", "label": "t:sections.common.button_link" },
    {
      "type": "select",
      "id": "background",
      "label": "t:sections.common.background",
      "options": [
        { "value": "default", "label": "t:sections.common.background_options.default" },
        { "value": "alt", "label": "t:sections.common.background_options.alt" },
        { "value": "accent", "label": "t:sections.common.background_options.accent" }
      ],
      "default": "alt"
    }
  ],
  "presets": [{ "name": "t:sections.image_with_text.name" }]
}
{% endschema %}
