<section class="section section--{{ section.settings.background }}">
  <div class="page-width">
    <div class="section-heading section-heading--center" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <ul class="collection-grid collection-grid--{{ section.blocks.size | at_most: 4 }}" role="list">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        <li data-reveal style="--reveal-delay: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <a href="{% if collection != blank %}{{ collection.url }}{% else %}{{ routes.collections_url }}{% endif %}" class="collection-tile">
            <div class="collection-tile__media">
              {%- assign tile_image = block.settings.image | default: collection.featured_image -%}
              {%- if tile_image != blank -%}
                {{
                  tile_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '375, 550, 750, 1100',
                    sizes: '(min-width: 750px) 33vw, 100vw',
                    loading: 'lazy'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </div>
            <span class="collection-tile__title">
              {%- if collection != blank -%}{{ collection.title }}{%- else -%}{{ 'sections.collection_list.placeholder' | t }}{%- endif -%}
              {% render 'icon', name: 'arrow' %}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "class": "section-collection-list",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.common.eyebrow", "default": "Shop by ritual" },
    { "type": "text", "id": "heading", "label": "t:sections.common.heading", "default": "Find your care" },
    {
      "type": "select",
      "id": "background",
      "label": "t:sections.common.background",
      "options": [
        { "value": "default", "label": "t:sections.common.background_options.default" },
        { "value": "alt", "label": "t:sections.common.background_options.alt" },
        { "value": "accent", "label": "t:sections.common.background_options.accent" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_list.blocks.collection.name",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.collection_list.blocks.collection.settings.collection.label" },
        { "type": "image_picker", "id": "image", "label": "t:sections.collection_list.blocks.collection.settings.image.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.name",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
