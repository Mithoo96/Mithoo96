{%- assign collection = section.settings.collection | default: collections.all -%}

<section class="section section--{{ section.settings.background }}">
  <div class="page-width">
    <div class="section-heading{% if section.settings.center %} section-heading--center{% endif %}" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <ul class="product-grid product-grid--{{ section.settings.columns }}" role="list">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <li data-reveal style="--reveal-delay: {{ forloop.index0 | modulo: 4 }};">{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <li>{% render 'product-card' %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.show_view_all and collection != blank -%}
      <div class="section-footer">
        <a href="{{ collection.url }}" class="button button--outline">{{ 'sections.featured_collection.view_all' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.common.eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "t:sections.common.heading", "default": "Loved by hands everywhere" },
    { "type": "checkbox", "id": "center", "label": "t:sections.common.center", "default": true },
    { "type": "collection", "id": "collection", "label": "t:sections.featured_collection.settings.collection.label" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:sections.featured_collection.settings.products_to_show.label",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:sections.featured_collection.settings.columns.label",
      "default": 4
    },
    { "type": "checkbox", "id": "show_view_all", "label": "t:sections.featured_collection.settings.show_view_all.label", "default": true },
    {
      "type": "select",
      "id": "background",
      "label": "t:sections.common.background",
      "options": [
        { "value": "default", "label": "t:sections.common.background_options.default" },
        { "value": "alt", "label": "t:sections.common.background_options.alt" },
        { "value": "accent", "label": "t:sections.common.background_options.accent" }
      ],
      "default": "default"
    }
  ],
  "presets": [{ "name": "t:sections.featured_collection.name" }]
}
{% endschema %}
