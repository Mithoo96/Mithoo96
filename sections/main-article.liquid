<article class="section">
  <div class="page-width page-width--narrow">
    <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="page__title">{{ article.title | escape }}</h1>
    {%- if article.image -%}
      <div class="article__image">
        {{ article.image | image_url: width: 1600 | image_tag: widths: '550, 750, 1100, 1600', sizes: '(min-width: 990px) 800px, 100vw', loading: 'eager' }}
      </div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <a href="{{ blog.url }}" class="link-button">&larr; {{ 'blogs.article.back_to_blog' | t: title: blog.title }}</a>
  </div>
</article>

{% schema %}
{
  "name": "t:sections.main_article.name",
  "class": "section-main-article"
}
{% endschema %}
