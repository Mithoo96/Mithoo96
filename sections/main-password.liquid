<section class="password">
  <div class="password__box">
    <p class="eyebrow">{{ 'general.password_page.coming_soon' | t }}</p>
    <h1 class="password__title">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <div class="newsletter-form__field">
        <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.label' | t }}</label>
        <input id="PasswordNewsletter" type="email" name="contact[email]" class="input" placeholder="{{ 'newsletter.label' | t }}" autocomplete="email" required>
        <button type="submit" class="button">{{ 'newsletter.button' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary class="link-button">{{ 'general.password_page.login_link' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {{ form.errors | default_errors }}
        <label for="Password" class="visually-hidden">{{ 'general.password_page.password' | t }}</label>
        <input id="Password" type="password" name="password" class="input" placeholder="{{ 'general.password_page.password' | t }}" autocomplete="current-password">
        <button type="submit" class="button button--outline">{{ 'general.password_page.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "class": "section-main-password"
}
{% endschema %}
