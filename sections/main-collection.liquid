{%- paginate collection.products by section.settings.products_per_page -%}
  <section class="section collection">
    <div class="page-width">
      <header class="collection__header">
        <p class="eyebrow">{{ 'templates.collection.eyebrow' | t }}</p>
        <h1 class="collection__title">{{ collection.title | escape }}</h1>
        {%- if section.settings.show_description and collection.description != blank -%}
          <div class="collection__description rte">{{ collection.description }}</div>
        {%- endif -%}
      </header>

      <div class="collection__toolbar">
        <p class="collection__count">{{ 'templates.collection.product_count' | t: count: collection.products_count }}</p>
        {%- if section.settings.enable_sorting -%}
          <form class="collection__sort" data-sort-form>
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}
                <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
              {%- endfor -%}
            {%- endfor -%}
            <label for="SortBy" class="visually-hidden">{{ 'templates.collection.sort_by' | t }}</label>
            <select id="SortBy" name="sort_by" class="select" data-sort-select>
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
            <noscript><button type="submit" class="button button--outline">{{ 'templates.collection.sort_by' | t }}</button></noscript>
          </form>
        {%- endif -%}
      </div>

      {%- if section.settings.enable_filtering and collection.filters != empty -%}
        <form class="filters" data-filter-form>
          <input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'list' -%}
              <details class="filters__group">
                <summary class="filters__summary">
                  {{ filter.label | escape }}
                  {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif -%}
                </summary>
                <ul class="filters__list" role="list">
                  {%- for value in filter.values -%}
                    <li>
                      <label class="filters__option{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        >
                        {{ value.label | escape }} <span class="filters__count">({{ value.count }})</span>
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- elsif filter.type == 'price_range' -%}
              <details class="filters__group">
                <summary class="filters__summary">{{ filter.label | escape }}</summary>
                <div class="filters__price">
                  <label>
                    <span class="visually-hidden">{{ 'templates.collection.from' | t }}</span>
                    <input class="input" type="number" name="{{ filter.min_value.param_name }}"
                      {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"{% endif %}
                      placeholder="0" min="0">
                  </label>
                  <span aria-hidden="true">&ndash;</span>
                  <label>
                    <span class="visually-hidden">{{ 'templates.collection.to' | t }}</span>
                    <input class="input" type="number" name="{{ filter.max_value.param_name }}"
                      {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"{% endif %}
                      placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}" min="0">
                  </label>
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
          <div class="filters__actions">
            <button type="submit" class="button button--small">{{ 'templates.collection.apply' | t }}</button>
            <a href="{{ collection.url }}?sort_by={{ collection.sort_by | default: collection.default_sort_by }}" class="link-button">{{ 'templates.collection.clear' | t }}</a>
          </div>
        </form>
      {%- endif -%}

      {%- if collection.products.size > 0 -%}
        <ul class="product-grid product-grid--{{ section.settings.columns }}" role="list">
          {%- for product in collection.products -%}
            {%- if forloop.index <= 4 -%}
              {%- assign loading = 'eager' -%}
            {%- else -%}
              {%- assign loading = 'lazy' -%}
            {%- endif -%}
            <li>{% render 'product-card', product: product, loading: loading %}</li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="empty-state">{{ 'templates.collection.empty' | t }}</p>
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 48, "step": 4, "label": "t:sections.main_collection.settings.products_per_page.label", "default": 16 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "t:sections.featured_collection.settings.columns.label", "default": 4 },
    { "type": "checkbox", "id": "show_description", "label": "t:sections.main_collection.settings.show_description.label", "default": true },
    { "type": "checkbox", "id": "enable_sorting", "label": "t:sections.main_collection.settings.enable_sorting.label", "default": true },
    { "type": "checkbox", "id": "enable_filtering", "label": "t:sections.main_collection.settings.enable_filtering.label", "default": true }
  ]
}
{% endschema %}
