{%- liquid
  assign networks = 'instagram,tiktok,facebook,youtube' | split: ','
-%}
<ul class="social-icons" role="list">
  {%- for network in networks -%}
    {%- assign setting_id = 'social_' | append: network | append: '_link' -%}
    {%- assign link = settings[setting_id] -%}
    {%- if link != blank -%}
      <li>
        <a href="{{ link }}" target="_blank" rel="noopener" class="social-icons__link">
          {% render 'icon', name: network %}
          <span class="visually-hidden">{{ network | capitalize }}</span>
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
