{%- comment -%}
  Renders a product or variant price.
  Accepts:
  - product: {Object} product (required)
  - variant: {Object} variant to price, defaults to the selected or first available variant
  - show_range: {Boolean} show "from" price when variants differ in price
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare_at_price = target.compare_at_price
  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
  endif
-%}

<div class="price{% if on_sale %} price--on-sale{% endif %}{% unless target.available %} price--sold-out{% endunless %}">
  {%- if show_range and product.price_varies -%}
    <span class="price__regular">{{ 'products.price.from_price' | t: price: product.price_min | money }}</span>
  {%- else -%}
    <span class="visually-hidden">{% if on_sale %}{{ 'products.price.sale_price' | t }}{% else %}{{ 'products.price.regular_price' | t }}{% endif %}</span>
    <span class="price__regular">{{ price | money }}</span>
    {%- if on_sale -%}
      <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
      <s class="price__compare">{{ compare_at_price | money }}</s>
    {%- endif -%}
  {%- endif -%}
  {%- if target.unit_price_measurement -%}
    <small class="price__unit">
      {{ target.unit_price | money }}/
      {%- if target.unit_price_measurement.reference_value != 1 -%}
        {{ target.unit_price_measurement.reference_value }}
      {%- endif -%}
      {{ target.unit_price_measurement.reference_unit }}
    </small>
  {%- endif -%}
</div>
