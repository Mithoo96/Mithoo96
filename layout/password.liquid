<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ settings.type_heading_font | font_face: font_display: 'swap' }}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}

    {% style %}
      :root {
        --font-heading-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
        --font-heading-weight: {{ settings.type_heading_font.weight }};
        --font-heading-style: {{ settings.type_heading_font.style }};
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --font-body-style: {{ settings.type_body_font.style }};
        --color-background: {{ settings.color_background }};
        --color-foreground: {{ settings.color_foreground }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-contrast: {{ settings.color_accent_contrast }};
        --color-sale: {{ settings.color_sale }};
        --color-highlight: {{ settings.color_highlight }};
        --color-surface-alt: {{ settings.color_surface_alt }};
        --color-border: {{ settings.color_foreground | color_modify: 'alpha', 0.12 }};
        --color-muted: {{ settings.color_foreground | color_modify: 'alpha', 0.65 }};
        --color-surface: {{ settings.color_foreground | color_modify: 'alpha', 0.04 }};
        --page-width: {{ settings.page_width }}px;
        --radius: {{ settings.corner_radius }}px;
        --card-ratio: {{ settings.card_image_ratio }};
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>

  <body class="template-password">
    <main id="MainContent" class="main" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
