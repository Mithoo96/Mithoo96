# Mithoo Business OS — web app environment. Copy to .env.local and fill in.
# NEVER commit real values. .env* files are git-ignored (except this example).

# --- Supabase (public: safe in the browser) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets ------------------------------------------------------
# Service role key: used ONLY server-side for Storage signed URLs. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection used by server code (user requests run as the
# RLS-scoped `mbos_app` role). Use the Supabase pooler "transaction" or
# "session" connection string. Local dev: postgres://postgres:postgres@localhost:5432/mbos_dev
DATABASE_URL=
DATABASE_POOL_MAX=5
# "require" for Supabase/hosted Postgres, "disable" for local Postgres.
DATABASE_SSL=require

# Bearer token for /api/cron/risk-scan (min 32 chars). Generate: openssl rand -hex 32
CRON_SECRET=

APP_ENV=development

# --- Integration secrets -------------------------------------------------------
# integration_connections.credentials_ref = "ZILE_TIKTOK_MOCK" resolves to
# INTEGRATION_SECRET_ZILE_TIKTOK_MOCK. The database never stores secrets.
# MOCK TikTok Shop webhook signing secret (demo only):
INTEGRATION_SECRET_ZILE_TIKTOK_MOCK=

# --- Tests ---------------------------------------------------------------------
# Disposable LOCAL database for integration tests (it is wiped on every run).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/mbos_test
# DEBUG_SQL_ERRORS=1   # log raw Postgres errors server-side while debugging
