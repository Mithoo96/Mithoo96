{
  "name": "mithoo-media-group",
  "version": "1.0.0",
  "private": true,
  "description": "Mithoo Media Group — trilingual conversion website, secure lead API and GoHighLevel CRM integration.",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node server/index.js",
    "dev": "node scripts/build.js && node --watch-path=server server/index.js",
    "test": "NODE_ENV=test node --test tests/unit/*.test.js",
    "test:e2e": "node scripts/build.js && NODE_ENV=test node tests/e2e/run.js",
    "outbox:retry": "node scripts/retry-outbox.js",
    "health": "node scripts/health.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "axe-core": "^4.10.0",
    "playwright-core": "1.56.1"
  }
}
