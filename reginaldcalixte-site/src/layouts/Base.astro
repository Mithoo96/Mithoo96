---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/public-sans/wght.css';
import '../styles/global.css';
import serifLatin from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import sansLatin from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  headerTone?: 'dark' | 'light';
  noindex?: boolean;
}

const DEFAULT_TITLE = 'Me Réginald Calixte — Candidat à la députation, 1ère Circonscription de Saint-Marc';
const DEFAULT_DESC = "Me Réginald Calixte, candidat à la députation pour la 1ère Circonscription de Saint-Marc. Yon lòt lidèchip ! Une vision fondée sur la dignité, la gouvernance et l'engagement citoyen.";
const OG_DESC = "Yon lòt lidèchip ! Une vision fondée sur la dignité, la gouvernance et l'engagement citoyen pour Saint-Marc.";

const { title, description = DEFAULT_DESC, image = '/og-reginald-calixte.jpg', headerTone = 'dark', noindex = false } = Astro.props;
const fullTitle = title ? `${title} — Me Réginald Calixte` : DEFAULT_TITLE;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const ogImage = new URL(image, Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Réginald Calixte',
  jobTitle: 'Candidat à la députation, 1ère Circonscription de Saint-Marc',
  nationality: 'Haïtienne',
  url: 'https://www.reginaldcalixte.com/',
  image: new URL('/presse/reginald-calixte-portrait-officiel.jpg', Astro.site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Saint-Marc', addressRegion: 'Artibonite', addressCountry: 'Haïti' },
  knowsAbout: ['Droit', 'Gouvernance locale', 'Développement communautaire', 'Communication publique'],
  description: 'Me Réginald Calixte, avocat inscrit au Barreau de Port-au-Prince, candidat à la députation pour la 1ère Circonscription de Saint-Marc. Yon lòt lidèchip !',
  sameAs: ['https://www.facebook.com/reginald.calixte.90', 'https://www.instagram.com/reginaldcalixte/'],
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Réginald Calixte" />
    <meta name="keywords" content="Réginald Calixte, Reginald Calixte, candidat députation Saint-Marc, 1ère circonscription Saint-Marc, Saint-Marc Haïti, leadership Saint-Marc, développement Saint-Marc, juriste haïtien, avocat Port-au-Prince, développement communautaire Haïti, gouvernance locale Haïti" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#001856" />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={title ? description : OG_DESC} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={DEFAULT_TITLE} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Réginald Calixte" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={title ? description : OG_DESC} />
    <meta name="twitter:image" content={ogImage.href} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header tone={headerTone} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
