---
import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = ui[Astro.props.lang];
---
<dialog class="lightbox on-dark" data-lightbox aria-label={t.imageEnlarged}>
  <div class="lightbox__inner">
    <div class="lightbox__bar">
      <span class="num" data-lb-count></span>
      <button class="icon-btn" type="button" data-lb-close aria-label={t.close}><Icon name="close" /></button>
    </div>
    <div class="lightbox__stage"><img data-lb-img alt="" /></div>
    <div class="lightbox__nav">
      <button class="icon-btn" type="button" data-lb-prev aria-label={t.prevImage}><Icon name="prev" /></button>
      <p class="lightbox__caption" data-lb-caption></p>
      <button class="icon-btn" type="button" data-lb-next aria-label={t.nextImage}><Icon name="next" /></button>
    </div>
  </div>
</dialog>
