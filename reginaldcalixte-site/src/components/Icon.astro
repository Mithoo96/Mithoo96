---
interface Props { name: 'arrow' | 'arrow-down' | 'download' | 'play' | 'close' | 'prev' | 'next' | 'facebook' | 'instagram' | 'phone' | 'mail' | 'pin' | 'check'; class?: string }
const { name, class: cls } = Astro.props;
const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-width': 1.6, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---
{name === 'arrow' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M4 12h15M13 6l6 6-6 6" /></svg>}
{name === 'arrow-down' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M12 4v15M6 13l6 6 6-6" /></svg>}
{name === 'download' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M12 3v12M7 10l5 5 5-5M4 20h16" /></svg>}
{name === 'play' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z" /></svg>}
{name === 'close' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M5 5l14 14M19 5L5 19" /></svg>}
{name === 'prev' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M20 12H5M11 6l-6 6 6 6" /></svg>}
{name === 'next' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M4 12h15M13 6l6 6-6 6" /></svg>}
{name === 'check' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M4 12.5l5 5L20 6.5" /></svg>}
{name === 'phone' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2" /></svg>}
{name === 'mail' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><rect x="3" y="5" width="18" height="14" rx="1" /><path d="M3 7l9 6 9-6" /></svg>}
{name === 'pin' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M12 21s-7-6.2-7-11.5a7 7 0 0114 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>}
{name === 'facebook' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21z" /></svg>}
{name === 'instagram' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7.3A4.7 4.7 0 1016.7 12 4.7 4.7 0 0012 7.3zm0 7.7a3 3 0 113-3 3 3 0 01-3 3zm6-7.9a1.1 1.1 0 11-1.1-1.1A1.1 1.1 0 0118 7.1zM21 8a5.4 5.4 0 00-1.5-3.8A5.4 5.4 0 0015.7 2.7C14.2 2.6 9.8 2.6 8.3 2.7a5.4 5.4 0 00-3.8 1.5A5.4 5.4 0 003 8c-.1 1.5-.1 6 0 7.5a5.4 5.4 0 001.5 3.8 5.4 5.4 0 003.8 1.5c1.5.1 5.9.1 7.4 0a5.4 5.4 0 003.8-1.5 5.4 5.4 0 001.5-3.8c.1-1.5.1-6 0-7.5zm-2 9.1a3 3 0 01-1.7 1.7c-1.2.5-4 .4-5.3.4s-4.1.1-5.3-.4a3 3 0 01-1.7-1.7c-.5-1.2-.4-4-.4-5.3s-.1-4.1.4-5.3a3 3 0 011.7-1.7C8 4.4 10.8 4.5 12 4.5s4.1-.1 5.3.4a3 3 0 011.7 1.7c.5 1.2.4 4 .4 5.3s.1 4.1-.4 5.3z" /></svg>}
