---
import Icon from './Icon.astro';
import { useLang, type Lang } from '../i18n';
interface Props { lang: Lang }
const { t, L, lang } = useLang(Astro.props.lang);
---
<section class="newsletter" id="restons-connectes" aria-labelledby="nl-title">
  <div class="wrap newsletter__grid">
    <div data-reveal>
      <h2 class="h2 ruled" id="nl-title">{t.nlTitle}</h2>
      <p class="mt-2 newsletter__intro">{t.nlIntro}</p>
    </div>
    <form class="newsletter__form" data-form="newsletter" action="/api/subscribe" method="post"
      data-success-title={t.nlSuccessTitle}
      data-success-text={t.nlSuccessText}
      data-sending={t.nlSending} data-reveal style="--d:.1s">
      <div class="newsletter__fields">
        <div class="field">
          <label for="nl-first">{t.firstName}</label>
          <input class="input" id="nl-first" name="firstName" autocomplete="given-name" required maxlength="80" data-msg-required={t.msgFirstName} />
          <p class="field-error" data-error-for="firstName" aria-live="polite"></p>
        </div>
        <div class="field">
          <label for="nl-last">{t.lastName}</label>
          <input class="input" id="nl-last" name="lastName" autocomplete="family-name" required maxlength="80" data-msg-required={t.msgLastName} />
          <p class="field-error" data-error-for="lastName" aria-live="polite"></p>
        </div>
        <div class="field newsletter__email">
          <label for="nl-email">{t.email}</label>
          <input class="input" id="nl-email" name="email" type="email" autocomplete="email" required maxlength="160" data-msg-required={t.msgEmail} data-msg-email={t.msgEmailInvalid} />
          <p class="field-error" data-error-for="email" aria-live="polite"></p>
        </div>
      </div>
      <div class="hp" aria-hidden="true"><label>{t.honeypot} <input name="website" tabindex="-1" autocomplete="off" /></label></div>
      <input type="hidden" name="_t" value="" />
      <input type="hidden" name="lang" value={lang} />
      <div class="cluster mt-2">
        <button class="btn btn--signal" type="submit">{t.nlSubmit} <Icon name="arrow" /></button>
      </div>
      <p class="form-status mt-2" data-form-status role="status" tabindex="-1"></p>
      <p class="newsletter__legal">{t.nlLegalBefore} <a href={L('/politique-de-confidentialite')}>{t.nlLegalLink}</a>.</p>
    </form>
  </div>
</section>
<style>
  .newsletter { padding-block: var(--section); background: var(--paper); }
  .newsletter h2 { color: var(--navy); }
  .newsletter__intro { max-width: 40ch; color: var(--ink-2); }
  .newsletter__grid { display: grid; gap: 3rem var(--gutter); }
  .newsletter__fields { display: grid; gap: 1.75rem var(--gutter); }
  .newsletter .input { background: transparent; border: 0; border-bottom: 1.5px solid var(--ink); border-radius: 0; padding-inline: 0; min-height: 48px; }
  .newsletter .input:focus { box-shadow: none; border-bottom-color: var(--orange-ink); border-bottom-width: 2px; }
  .newsletter .input[aria-invalid='true'] { border-bottom-color: #b3261e; }
  .newsletter__legal { margin-top: 1.4rem; font-family: var(--sans); font-size: .82rem; color: var(--ink-3); max-width: 62ch; }
  .newsletter__legal a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 720px) { .newsletter__fields { grid-template-columns: 1fr 1fr; } .newsletter__email { grid-column: 1 / -1; } }
  @media (min-width: 1024px) { .newsletter__grid { grid-template-columns: 5fr 7fr; align-items: start; } }
</style>
