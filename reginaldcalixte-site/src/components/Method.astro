---
import Icon from './Icon.astro';
import { useLang, type Lang } from '../i18n';
interface Props { link?: boolean; title?: string; lead?: string; lang: Lang }
const { t, c, L } = useLang(Astro.props.lang);
const { link = true, title, lead = t.iValue } = Astro.props;
const methode = c.methode;
---
  <section class="method section" aria-labelledby="method-title">
    <div class="wrap">
      <div class="section-head">
        <div data-reveal>
          {title ? <h2 class="h2" id="method-title">{title}</h2> : <h2 class="h2" id="method-title">{t.methodTitle}</h2>}
          <p class="lead mt-2">{lead}</p>
        </div>
      </div>
      <ol class="method__steps">
        {methode.map((m, i) => (
          <li data-reveal style={`--d:${i * 0.07}s`}>
            <p>{m}</p>
          </li>
        ))}
      </ol>
      {link && <a class="link-arrow mt-4" href={L('/vision')} data-reveal>{t.exploreVision} <Icon name="arrow" /></a>}
    </div>
  </section>

<style>
  /* -------------------------------------------------------------- Method */
  .method__steps li { padding-block: 1.3rem; border-top: 1px solid var(--rule); }
  .method__steps li:last-child { border-bottom: 1px solid var(--rule); }
  .method__steps p { font-family: var(--serif); font-size: var(--fs-xl); line-height: 1.2; font-variation-settings: 'opsz' 36; }
  .method__steps p::first-letter { text-transform: uppercase; }
  @media (min-width: 1024px) {
    .method__steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--gutter); }
    .method__steps li { padding-block: 1.6rem 0; border-top: 2px solid var(--navy); }
    .method__steps li:last-child { border-bottom: 0; }
    .method__steps p { font-size: 1.35rem; }
  }
</style>
