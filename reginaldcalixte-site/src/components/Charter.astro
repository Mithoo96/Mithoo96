---
import { useLang, type Lang } from '../i18n';
interface Props { lang: Lang }
const { t, c } = useLang(Astro.props.lang);
const convictions = c.convictions;
---
<section class="charter section" aria-labelledby="charter-title">
  <div class="wrap charter__grid">
    <h2 class="h2 ruled charter__title" id="charter-title" data-reveal>{t.beliefsTitle}</h2>
    <ul class="charter__list">
      {convictions.map((c, i) => <li data-reveal style={`--d:${(i % 2) * 0.06}s`}>{c}</li>)}
    </ul>
  </div>
</section>

<style>
  .charter { background: var(--white); }
  .charter__grid { display: grid; gap: 2.5rem var(--gutter); }
  .charter__title { color: var(--navy); max-width: 14ch; }
  .charter__list li { padding-block: 1.35rem; border-bottom: 1px solid var(--rule); font-size: clamp(1.25rem, 1rem + .9vw, 1.65rem); line-height: 1.3; color: var(--ink); }
  .charter__list li:first-child { border-top: 1px solid var(--rule); }
  @media (min-width: 1024px) {
    .charter__grid { grid-template-columns: 5fr 7fr; align-items: start; }
    .charter__title { position: sticky; top: calc(var(--header-h) + 2rem); }
  }
</style>
