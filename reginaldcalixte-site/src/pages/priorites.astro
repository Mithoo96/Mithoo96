---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import NextLink from '../components/NextLink.astro';
import Icon from '../components/Icon.astro';
import { axes, axesIntro } from '../data/site';
---
<Base title="Priorités" description="Les pivots de l'engagement de Me Réginald Calixte : gouvernance locale, Bas-Artibonite, redevabilité budgétaire, décentralisation, État de droit…">
  <PageHead title="Les pivots de mon engagement" subtitle={axesIntro} crumb="Priorités" image="terrain-marche" />

  <section class="prio section" style="padding-bottom:clamp(3rem,2rem + 3vw,5rem)" aria-label="Les huit priorités">
    <div class="wrap">
      <ol class="prio__grid">
        {axes.map((a, i) => (
          <li data-reveal style={`--d:${(i % 4) * 0.06}s`}>
            <a href={`/vision#axe-${i + 1}`} class="prio__card">
              <h2 class="prio__title">{a.title}</h2>
              <p class="prio__text">{a.text}</p>
              <span class="prio__more">Explorer <span class="visually-hidden">: {a.title}</span><Icon name="arrow" /></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <NextLink href="/vision" cta="Explorer la vision complète" />
</Base>

<style>
  .prio__grid { display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--rule-strong); border-left: 1px solid var(--rule-strong); }
  .prio__grid li { border-right: 1px solid var(--rule-strong); border-bottom: 1px solid var(--rule-strong); }
  .prio__card {
    position: relative; display: flex; flex-direction: column; height: 100%; min-height: 260px; padding: 1.75rem 1.5rem 1.5rem;
    text-decoration: none; background: var(--paper); transition: background-color .45s var(--ease), color .45s var(--ease);
  }
  .prio__title { font-family: var(--serif); font-size: var(--fs-xl); line-height: 1.15; color: var(--navy); font-variation-settings: 'opsz' 36; transition: color .45s var(--ease); }
  .prio__text { margin-top: .9rem; flex: 1; font-size: .95rem; color: var(--ink-2); transition: color .45s var(--ease); }
  .prio__more { margin-top: 1.4rem; display: inline-flex; align-items: center; gap: .5rem; font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); }
  .prio__more :global(svg) { width: 16px; height: 16px; transition: transform .35s var(--ease); }
  .prio__card:hover, .prio__card:focus-visible { background: var(--navy); }
  .prio__card:hover .prio__title, .prio__card:hover .prio__more, .prio__card:focus-visible .prio__title, .prio__card:focus-visible .prio__more { color: #fff; }
  .prio__card:hover .prio__text, .prio__card:focus-visible .prio__text { color: rgba(255,255,255,.82); }
  .prio__card:hover .prio__more :global(svg) { transform: translateX(5px); }
  @media (min-width: 640px) { .prio__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .prio__grid { grid-template-columns: repeat(4, 1fr); } .prio__card { min-height: 340px; padding: 2rem 1.75rem 1.75rem; } }
</style>
