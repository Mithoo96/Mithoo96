---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import NextLink from '../components/NextLink.astro';
import Icon from '../components/Icon.astro';
import { axes, axesIntro } from '../data/site';
---
<Base title="Priorités" description="Les pivots de l'engagement de Me Réginald Calixte : gouvernance locale, Bas-Artibonite, redevabilité budgétaire, décentralisation, État de droit…">
  <PageHead title="Les pivots de mon engagement" subtitle={axesIntro} crumb="Priorités" image="terrain-marche" position="55% 35%" />

  <section class="prio" aria-label="Priorités">
    <div class="wrap">
      <ul class="prio__list">
        {axes.map((a, i) => (
          <li data-reveal>
            <h2 class="prio__title">{a.title}</h2>
            <div class="prio__body">
              <p>{a.text}</p>
              <a href={`/vision#axe-${i + 1}`}>Explorer<span class="visually-hidden"> : {a.title}</span> <Icon name="arrow" /></a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <NextLink href="/vision" cta="Explorer la vision complète" />
</Base>

<style>
  .prio { padding-block: var(--section) clamp(3rem, 2rem + 3vw, 5rem); }
  .prio__list li { display: grid; gap: 1rem var(--gutter); padding-block: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem); border-top: 1px solid var(--rule-strong); }
  .prio__list li:first-child { border-top: 4px solid var(--navy); }
  .prio__title { font-family: var(--display); font-stretch: 74%; font-weight: 640; font-size: clamp(1.9rem, 1.3rem + 2.2vw, 3.2rem); line-height: 1; letter-spacing: -0.012em; color: var(--navy); text-wrap: balance; }
  .prio__body { display: grid; gap: 1rem; align-content: start; }
  .prio__body p { color: var(--ink-2); font-size: var(--fs-lg); max-width: 46ch; }
  .prio__body a { justify-self: start; display: inline-flex; align-items: center; gap: .5rem; font-family: var(--sans); font-weight: 600; text-decoration: none; color: var(--ink); border-bottom: 1.5px solid var(--orange); padding-bottom: .2rem; }
  .prio__body a :global(svg) { width: 18px; height: 18px; transition: transform .35s var(--ease); }
  .prio__body a:hover :global(svg) { transform: translateX(4px); }
  @media (min-width: 1024px) {
    .prio__list li { grid-template-columns: 7fr 5fr; align-items: start; }
    .prio__body { padding-top: .5rem; }
  }
</style>
