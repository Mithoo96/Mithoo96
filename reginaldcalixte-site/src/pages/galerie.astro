---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Lightbox from '../components/Lightbox.astro';
import { photo } from '../data/photos';
import { gallery } from '../data/site';
const items = await Promise.all(gallery.map(async (g) => ({ ...g, large: (await getImage({ src: photo(g.image), width: 1800, format: 'webp' })).src })));
---
<Base title="Galerie" description="En images : Saint-Marc, l'Artibonite, la population, les jeunes, les marchés, la mer et le patrimoine haïtien." headerTone="light">
  <PageHead title="Galerie" subtitle="Saint-Marc, l'Artibonite, la population, les jeunes, les marchés, la mer et le patrimoine haïtien." crumb="Galerie" />
  <section class="gal section" aria-label="Photographies">
    <div class="wrap">
      <ul class="gal__grid">
        {items.map((g, i) => (
          <li data-reveal style={`--d:${(i % 3) * 0.06}s`}>
            <a href={g.large} data-lightbox-item data-alt={g.alt} data-caption="">
              <Picture src={photo(g.image)} formats={['avif', 'webp']} widths={[480, 800]} sizes="(min-width: 1024px) 31vw, (min-width: 640px) 46vw, 92vw" alt={g.alt} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Lightbox />
</Base>
<style>
  .gal__grid { columns: 1; column-gap: var(--gutter); }
  .gal__grid li { break-inside: avoid; margin-bottom: var(--gutter); }
  .gal__grid a { display: block; overflow: hidden; }
  .gal__grid :global(img) { width: 100%; transition: transform 1.2s var(--ease), filter .6s; }
  .gal__grid a:hover :global(img) { transform: scale(1.03); }
  @media (min-width: 640px) { .gal__grid { columns: 2; } }
  @media (min-width: 1024px) { .gal__grid { columns: 3; } }
</style>
