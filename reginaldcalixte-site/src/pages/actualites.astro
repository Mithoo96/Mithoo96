---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { photo } from '../data/photos';
import { news, newsCategories } from '../data/site';
const nb = (t: string) => t.replace(/Saint-Marc/g, 'Saint\u2011Marc');
const [lead, ...others] = news;
---
<Base title="Actualités" description="Sur le terrain : les rencontres de Réginald Calixte avec la population, ses déplacements et ses communiqués.">
  <PageHead title="Actualités" subtitle="Mes rencontres avec la population, mes déplacements et mes communautés se trouvent ici." crumb="Actualités" image="terrain-foule" />

  <section class="news section" aria-labelledby="news-title">
    <div class="wrap">
      <h2 class="visually-hidden" id="news-title">Toutes les actualités</h2>
      <div class="filters" data-filter-group="#news-list" data-filter-status="#news-status" role="group" aria-label="Filtrer les actualités">
        <button type="button" data-filter="Tous" aria-pressed="true">Tous</button>
        {newsCategories.map((c) => <button type="button" data-filter={c} aria-pressed="false">{c}</button>)}
      </div>
      <p class="visually-hidden" id="news-status" role="status" aria-live="polite"></p>

      <ol class="news__list" id="news-list">
        <li class="news__lead" data-cat={lead.cat}>
          <article>
            <Picture src={photo(lead.image)} formats={['avif', 'webp']} widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 60vw, 92vw" alt="" />
            <div class="news__body">
              <p class="news__meta"><span>{lead.cat}</span><time datetime={lead.date}>{lead.dateLabel}</time></p>
              <h3 class="h2">{nb(lead.title)}</h3>
              <p class="lead mt-2">{lead.excerpt}</p>
            </div>
          </article>
        </li>
        {others.map((n, i) => (
          <li data-cat={n.cat} data-reveal style={`--d:${(i % 3) * 0.07}s`}>
            <article class="news__card">
              <Picture src={photo(n.image)} formats={['avif', 'webp']} widths={[480, 800]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw" alt="" />
              <p class="news__meta"><span>{n.cat}</span><time datetime={n.date}>{n.dateLabel}</time></p>
              <h3 class="h3">{nb(n.title)}</h3>
              <p class="news__excerpt">{n.excerpt}</p>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--rule-strong); }
  .filters button { min-height: 40px; padding: .45rem 1rem; border: 1px solid var(--rule-strong); background: transparent; border-radius: 999px; font-size: .86rem; font-weight: 550; cursor: pointer; transition: background-color .25s, color .25s, border-color .25s; }
  .filters button:hover { border-color: var(--navy); }
  .filters button[aria-pressed='true'] { background: var(--navy); color: #fff; border-color: var(--navy); }
  .news__list { display: grid; gap: 3.5rem var(--gutter); }
  .news__list li[hidden] { display: none; }
  .news__lead article { display: grid; gap: 1.75rem var(--gutter); }
  .news__lead :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .news__meta { display: flex; gap: 1rem; margin-bottom: .8rem; font-size: .74rem; letter-spacing: .14em; text-transform: uppercase; font-weight: 650; color: var(--ink-3); }
  .news__meta span { color: var(--orange-ink); }
  .news__card :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; margin-bottom: 1.25rem; }
  .news__excerpt { margin-top: .7rem; color: var(--ink-2); }
  @media (min-width: 640px) { .news__list { grid-template-columns: 1fr 1fr; } .news__lead { grid-column: 1 / -1; } }
  @media (min-width: 1024px) {
    .news__list { grid-template-columns: repeat(3, 1fr); }
    .news__lead article { grid-template-columns: 7fr 5fr; align-items: center; padding-bottom: 3.5rem; border-bottom: 1px solid var(--rule); }
  }
</style>
