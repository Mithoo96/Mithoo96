---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
// Page unique pour les trois langues (servie pour toute adresse inconnue)
---
<Base title="Page introuvable · Paj sa a pa egziste · Page not found" noindex alternates={false} headerTone="light">
  <section class="nf">
    <div class="wrap">
      <p class="nf__code">404</p>
      <div class="nf__langs">
        <div lang="fr">
          <h1 class="h2">La page que vous recherchez est introuvable.</h1>
          <a class="btn" href="/">Retour à l'accueil <Icon name="arrow" /></a>
        </div>
        <div lang="ht">
          <p class="h3">Nou pa jwenn paj w ap chèche a.</p>
          <a class="btn btn--ghost" href="/ht">Retounen lakay <Icon name="arrow" /></a>
        </div>
        <div lang="en">
          <p class="h3">The page you are looking for could not be found.</p>
          <a class="btn btn--ghost" href="/en">Back to home <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 80svh; display: grid; align-items: center; padding-top: calc(var(--header-h) + 3rem); padding-bottom: 5rem; }
  .nf__code { font-family: var(--display); font-stretch: 74%; font-weight: 640; font-size: clamp(6rem, 4rem + 10vw, 12rem); line-height: .85; color: var(--orange-ink); }
  .nf__langs { display: grid; gap: 2rem; margin-top: 2rem; }
  .nf__langs > div { display: grid; gap: 1rem; justify-items: start; padding-top: 1.25rem; border-top: 1px solid var(--rule); }
  .nf h1, .nf .h3 { color: var(--navy); }
  @media (min-width: 1024px) { .nf__langs { grid-template-columns: 1.4fr 1fr 1fr; } }
</style>
