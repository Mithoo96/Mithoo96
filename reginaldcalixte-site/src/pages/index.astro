---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Newsletter from '../components/Newsletter.astro';
import Charter from '../components/Charter.astro';
import Compass from '../components/Compass.astro';
import Method from '../components/Method.astro';
import { photo } from '../data/photos';
import { identity, hero, conviction, bio, ctaBand, gallery } from '../data/site';
---
<Base headerTone="light">
  <!-- ============================================================ HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__stage wrap">
      <h1 class="hero__title display" id="hero-title">
        <span class="visually-hidden">Me Réginald Calixte — </span>
        <span class="line"><span>«&nbsp;Yon lòt</span></span>
        <span class="line"><em><span>lidèchip&nbsp;!&nbsp;»</span></em></span>
      </h1>

      <div class="hero__portrait">
        <Picture
          src={photo('portrait-officiel')}
          formats={['avif', 'webp']}
          widths={[420, 640, 860, 1100]}
          sizes="(min-width: 900px) 34vw, 92vw"
          alt="Me Réginald Calixte — portrait officiel"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="hero__left">
        <p class="hero__role">{identity.status}<br />{identity.circonscription}</p>
      </div>

      <div class="hero__right">
        <p class="hero__lines">
          <strong>{hero.lines[0]}</strong>
          <strong>{hero.lines[1]}</strong>
        </p>
        <div class="cluster">
          <a class="btn" href="/vision">Découvrir la vision <Icon name="arrow" /></a>
          <a class="btn btn--ghost" href="/parcours">Mon parcours</a>
        </div>
      </div>
    </div>

    <div class="hero__band on-dark">
      <div class="wrap hero__band-grid">
        <p class="hero__name">{identity.name}</p>
        <p class="hero__descriptor">{identity.descriptor}</p>

      </div>
    </div>
  </section>

  <!-- ====================================================== CONVICTION -->
  <section class="conviction section" id="conviction" aria-label="Conviction">
    <div class="wrap grid-12">
      <figure class="conviction__body" data-reveal style="--d:.1s">
        <blockquote>
          <p><span class="q" aria-hidden="true">«</span>{conviction}</p>
        </blockquote>
        <figcaption>— Réginald Calixte</figcaption>
      </figure>
    </div>
  </section>

  <!-- ===================================================== QUI SUIS-JE -->
  <section class="about section bg-white" aria-labelledby="about-title">
    <div class="wrap about__grid">
      <div class="about__media" data-reveal>
        <Picture src={photo('portrait-editorial')} formats={['avif', 'webp']} widths={[480, 760, 1000]} sizes="(min-width: 1024px) 40vw, 92vw" alt="Réginald Calixte, portrait éditorial" />
      </div>
      <div class="about__text">
        <h2 class="h2" id="about-title" data-reveal>{bio.title}</h2>
        <div class="prose about__prose mt-3" data-reveal style="--d:.1s">
          {bio.paragraphs.map((p) => <p set:html={p} />)}
        </div>
        <p class="triad mt-3" data-reveal>
          {bio.triad.map((w) => <span>{w} </span>)}
        </p>
        <a class="link-arrow mt-3" href="/biographie" data-reveal>Découvrir son parcours complet <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <Charter />

  <Compass />

  <Method />

  <!-- ========================================================= GALERIE -->
  <section class="rail bg-navy-deep on-dark" aria-labelledby="rail-title" data-rail>
    <div class="wrap rail__head">
      <h2 class="visually-hidden" id="rail-title">Galerie</h2>
      <div class="rail__ctrl">
        <span class="num rail__count" data-rail-count aria-hidden="true">01 / {String(gallery.length).padStart(2, '0')}</span>
        <button class="icon-btn" type="button" data-rail-prev aria-label="Image précédente"><Icon name="prev" /></button>
        <button class="icon-btn" type="button" data-rail-next aria-label="Image suivante"><Icon name="next" /></button>
      </div>
    </div>
    <ul class="rail__track" data-rail-track tabindex="0" aria-label="Galerie — faire défiler horizontalement">
      {gallery.map((g) => (
        <li>
          <Picture src={photo(g.image)} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 900px) 46vw, 84vw" alt={g.alt} />
        </li>
      ))}
    </ul>
    <div class="wrap rail__foot"><a class="link-arrow" href="/galerie">Voir toute la galerie <Icon name="arrow" /></a></div>
  </section>

  <!-- ============================================================= CTA -->
  <section class="call on-dark" aria-labelledby="call-title">
    <div class="call__media" aria-hidden="true">
      <Picture src={photo('saint-marc-baie')} formats={['avif', 'webp']} widths={[800, 1400, 2000]} sizes="100vw" alt="" />
    </div>
    <div class="wrap call__inner">
      <h2 class="call__title" id="call-title" data-reveal>
        {ctaBand.map((l) => <span>{l} </span>)}
      </h2>
      <div class="cluster mt-3" data-reveal style="--d:.15s">
        <a class="btn btn--signal" href="/contact">Je m'engage <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href="#restons-connectes">Rester informé(e)</a>
      </div>
    </div>
  </section>

  <Newsletter />
</Base>

<style>
  /* --------------------------------------------------------------- Hero */
  .hero { background: var(--studio); position: relative; overflow: hidden; }
  .hero__stage {
    position: relative; display: grid; grid-template-columns: 1fr;
    padding-top: calc(var(--header-h) + 1.25rem);
  }
    .hero__title { color: var(--navy); margin-top: clamp(1rem, .5rem + 1.5vw, 2rem); position: relative; z-index: 2; font-size: clamp(3.1rem, 16.5vw, 6.5rem); }
  .hero__title .line { display: block; overflow: hidden; padding-bottom: .06em; }
  .hero__title .line > *, .hero__title .line > span { display: inline-block; }
  .hero__title em { font-style: italic; color: var(--orange); font-variation-settings: 'opsz' 72; }
  .hero__portrait {
    position: relative; margin-top: 1.5rem; margin-inline: calc(var(--gutter) * -1);
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 10%); mask-image: linear-gradient(180deg, transparent 0, #000 10%);
  }
  .hero__portrait :global(img) { width: 100%; aspect-ratio: 4 / 4.4; object-fit: cover; object-position: 50% 12%; }
  .hero__left, .hero__right { position: relative; z-index: 2; }
  .hero__left { padding-top: 1.75rem; }
  .hero__role { font-family: var(--serif); font-size: var(--fs-lg); line-height: 1.35; color: var(--navy); font-variation-settings: 'opsz' 36; }
  .hero__right { padding-block: 1.5rem 2.75rem; display: grid; gap: 1.75rem; }
  .hero__lines { display: grid; gap: .5rem; font-size: var(--fs-lg); line-height: 1.45; color: var(--ink); }
  .hero__lines strong { font-weight: 550; }
  .hero__lines strong:first-child { font-family: var(--serif); font-size: var(--fs-xl); font-weight: 500; color: var(--navy); font-variation-settings: 'opsz' 36; }

  .hero__band { background: var(--navy); color: var(--white); position: relative; z-index: 3; }
  .hero__band-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem var(--gutter); padding-block: 1.4rem; align-items: center; }
  .hero__name { font-family: var(--serif); font-size: 1.35rem; line-height: 1.1; grid-column: 1 / -1; font-variation-settings: 'opsz' 36; }
  .hero__descriptor { font-size: .95rem; color: rgba(255,255,255,.82); }

  @media (min-width: 900px) {
    .hero__stage {
      grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter);
      grid-template-rows: auto 1fr;
      min-height: min(max(100svh - 92px, 720px), 1040px);
    }
    .hero__title { grid-column: 1 / -1; text-align: center; font-size: clamp(4rem, 1rem + 7.2vw, 9.5rem); white-space: nowrap; }
    .hero__title .line { display: inline-block; vertical-align: bottom; }
    .hero__title .line + .line { margin-left: .22em; }
    .hero__portrait {
      grid-column: 4 / span 6; grid-row: 2; margin: 0; align-self: end; justify-self: center;
      width: min(100%, 560px); margin-top: -0.6rem; z-index: 1;
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 14%, #000 86%, transparent 100%), linear-gradient(180deg, transparent 0, #000 12%);
      -webkit-mask-composite: source-in;
      mask-image: linear-gradient(90deg, transparent 0, #000 14%, #000 86%, transparent 100%), linear-gradient(180deg, transparent 0, #000 12%);
      mask-composite: intersect;
    }
    .hero__portrait :global(img) { aspect-ratio: auto; height: 100%; max-height: calc(100svh - 330px); min-height: 430px; object-position: 50% 0; }
    .hero__left { grid-column: 1 / span 3; grid-row: 2; align-self: center; padding: 0; }
    .hero__right { grid-column: 10 / span 3; grid-row: 2; align-self: center; padding: 0; }
    .hero__right .cluster { flex-direction: column; align-items: stretch; }
    .hero__band-grid { grid-template-columns: 1fr auto; padding-block: 1.6rem; }
    .hero__name { grid-column: auto; font-size: 1.55rem; }
  }
  @media (min-width: 900px) and (max-width: 1180px) {
    .hero__left { grid-column: 1 / span 3; }
    .hero__portrait { grid-column: 4 / span 6; }
    .hero__lines strong:not(:first-child) { font-size: 1rem; }
  }

  /* Entrées */
  @media (prefers-reduced-motion: no-preference) {
    .hero__title .line > * { animation: rise 1.1s var(--ease) both; }
    .hero__title .line:nth-child(3) > * { animation-delay: .12s; }
    .hero__portrait { animation: fadeUp 1.4s var(--ease) .15s both; }
    .hero__left, .hero__right { animation: fade 1s var(--ease) .55s both; }
    .hero__band { animation: fade 1s var(--ease) .7s both; }
  }
  @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(28px) scale(1.02); } to { opacity: 1; transform: none; } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }

  /* ---------------------------------------------------------- Conviction */
  .conviction__body { grid-column: 1 / -1; }
  .conviction blockquote p {
    font-family: var(--serif); font-size: clamp(1.7rem, 1rem + 2.6vw, 3.4rem); line-height: 1.16;
    letter-spacing: -0.015em; color: var(--navy); font-variation-settings: 'opsz' 60; text-wrap: pretty;
  }
  .conviction .q { color: var(--orange); margin-right: .15em; }
  .conviction figcaption { margin-top: 2rem; font-size: 1rem; color: var(--ink-3); }
  @media (min-width: 900px) {
    .conviction__body { grid-column: 4 / span 9; }
    .conviction .q { position: absolute; transform: translateX(-100%); margin-left: -.1em; }
    .conviction blockquote p { position: relative; }
  }

  /* --------------------------------------------------------------- About */
  .about__grid { display: grid; gap: 3rem var(--gutter); }
  .about__media { position: relative; }
  .about__media :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 70% 30%; }
  .about__prose > :global(p:first-child)::first-letter {
    float: left; font-family: var(--serif); font-size: 4.4em; line-height: .82; margin: .06em .12em 0 0; color: var(--navy);
  }
  .triad { display: flex; flex-wrap: wrap; gap: .1em .45em; font-family: var(--serif); font-size: var(--fs-2xl); line-height: 1; color: var(--navy); font-variation-settings: 'opsz' 60; padding-block: 1.6rem; border-block: 1px solid var(--rule); }
  .triad span:nth-child(2) { font-style: italic; color: var(--orange-ink); }
  @media (min-width: 1024px) {
    .about__grid { grid-template-columns: 5fr 1fr 6fr; align-items: center; }
    .about__text { grid-column: 3; }
  }

  /* ---------------------------------------------------------------- Rail */
  .rail { padding-block: calc(var(--section) * .55) calc(var(--section) * .7); }
  .rail__head { display: flex; justify-content: flex-end; align-items: end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .rail__ctrl { display: flex; align-items: center; gap: .75rem; }
  .rail__count { font-size: .85rem; letter-spacing: .12em; margin-right: .5rem; color: rgba(255,255,255,.8); }
  .rail__track {
    display: flex; gap: clamp(.75rem, .5rem + 1vw, 1.5rem); overflow-x: auto; scroll-snap-type: x mandatory;
    padding-inline: max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter)));
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter)));
    scrollbar-width: none;
  }
  .rail__track::-webkit-scrollbar { display: none; }
  .rail__track li { flex: none; scroll-snap-align: start; height: clamp(280px, 52vh, 560px); }
  .rail__track :global(img) { height: 100%; width: auto; max-width: none; object-fit: cover; }
  .rail__foot { margin-top: 2.5rem; }

  /* ----------------------------------------------------------------- CTA */
  .call { position: relative; isolation: isolate; color: #fff; overflow: hidden; }
  .call__media { position: absolute; inset: 0; z-index: -2; }
  .call__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .call::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(100deg, rgba(0,15,56,.94) 0%, rgba(0,24,86,.82) 50%, rgba(0,24,86,.45) 100%); }
  .call__inner { padding-block: clamp(6rem, 4rem + 8vw, 11rem); }
  .call__title { font-family: var(--serif); font-size: clamp(2rem, 1rem + 3.6vw, 4.4rem); line-height: 1.04; letter-spacing: -0.02em; max-width: 20ch; font-variation-settings: 'opsz' 72; }
  .call__title span:last-child { font-style: italic; color: var(--orange); }
</style>
