---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Newsletter from '../components/Newsletter.astro';
import { photo } from '../data/photos';
import { identity, hero, conviction, bio, convictions, boussole, methode, axes, axesIntro, news, ctaBand, gallery } from '../data/site';
const nb = (t: string) => t.replace(/Saint-Marc/g, 'Saint‑Marc');
const [leadNews, ...moreNews] = news;
---
<Base>
  <!-- 1 — Ouverture photographique -->
  <section class="hero on-dark" aria-labelledby="hero-title">
    <div class="hero__media">
      <Picture
        src={photo('portrait-editorial')}
        formats={['avif', 'webp']}
        widths={[640, 1000, 1400, 1672]}
        sizes="100vw"
        alt="Me Réginald Calixte en costume bleu, bras croisés"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="wrap hero__content">
      <h1 class="hero__title" id="hero-title">Me Réginald Calixte</h1>
      <p class="hero__status">{identity.statusShort}</p>
      <p class="hero__sign" lang="ht">{identity.signature}</p>
      <div class="hero__actions">
        <a class="btn btn--light" href="/vision">Découvrir la vision <Icon name="arrow" /></a>
        <a class="hero__link" href="/parcours">Mon parcours</a>
      </div>
    </div>
  </section>

  <!-- 2 — La conviction, en typographie seule -->
  <section class="conviction" aria-label="Conviction">
    <div class="wrap">
      <figure class="conviction__fig">
        <blockquote><p>{nb(conviction)}</p></blockquote>
        <figcaption>Réginald Calixte</figcaption>
      </figure>
      <div class="conviction__lines" data-reveal style="--d:.1s">
        {hero.lines.map((l) => <p>{l}</p>)}
      </div>
    </div>
  </section>

  <!-- 3 — Qui suis-je : image à fond perdu -->
  <section class="bio" aria-labelledby="bio-title">
    <div class="bio__media">
      <Picture src={photo('terrain-foule')} formats={['avif', 'webp']} widths={[640, 960, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" alt="Réginald Calixte, souriant, au milieu de la population" />
    </div>
    <div class="bio__text">
      <h2 class="h2" id="bio-title" data-reveal>{bio.title}</h2>
      <div class="bio__prose" data-reveal style="--d:.08s">
        {bio.paragraphs.map((p) => <p set:html={p} />)}
      </div>
      <p class="bio__triad" lang="ht" data-reveal>{bio.triad.join(' ')}</p>
      <a class="link-arrow" href="/biographie" data-reveal>Découvrir son parcours complet <Icon name="arrow" /></a>
    </div>
  </section>

  <!-- 4 — Convictions -->
  <section class="beliefs on-dark" aria-labelledby="beliefs-title">
    <div class="wrap beliefs__grid">
      <h2 class="h2 ruled beliefs__title" id="beliefs-title">Ce en quoi je crois, sans concession.</h2>
      <ul class="beliefs__list">
        {convictions.map((c, i) => <li data-reveal style={`--d:${(i % 2) * 0.05}s`}>{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- 5 — Interlude photographique -->
  <div class="interlude" aria-hidden="true">
    <div class="interlude__media">
      <Picture src={photo('terrain-marche')} formats={['avif', 'webp']} widths={[640, 960, 1280]} sizes="100vw" alt="" />
    </div>
  </div>

  <!-- 6 — Boussole et méthode -->
  <section class="compass" aria-labelledby="compass-title">
    <div class="wrap">
      <h2 class="compass__title" id="compass-title" data-reveal>J'ai pour boussole&nbsp;:</h2>
      <ul class="compass__row">
        {boussole.map((b, i) => <li data-reveal style={`--d:${i * 0.07}s`}>{b}</li>)}
      </ul>
    </div>
  </section>

  <section class="method" aria-labelledby="method-title">
    <div class="wrap">
      <div class="method__head" data-reveal>
        <h2 class="h2 ruled" id="method-title">Le leadership-solution comme méthode</h2>
        <p>Je valorise:</p>
      </div>
      <ol class="method__path">
        {methode.map((m, i) => <li data-reveal style={`--d:${i * 0.06}s`}>{m.charAt(0).toUpperCase() + m.slice(1)}</li>)}
      </ol>
      <a class="link-arrow method__more" href="/vision" data-reveal>Explorer la vision complète <Icon name="arrow" /></a>
    </div>
  </section>

  <!-- 7 — Les pivots de l'engagement -->
  <section class="pivots" aria-labelledby="pivots-title">
    <div class="wrap pivots__grid">
      <div class="pivots__panel on-dark" data-reveal>
        <h2 class="h2" id="pivots-title">Les pivots de mon engagement</h2>
        <p>{axesIntro}</p>
        <a class="link-arrow" href="/priorites">Voir les priorités <Icon name="arrow" /></a>
      </div>
      <ul class="pivots__list">
        {axes.map((a, i) => (
          <li data-reveal style={`--d:${(i % 4) * 0.04}s`}>
            <a href={`/vision#axe-${i + 1}`}><span>{a.title}</span><Icon name="arrow" /></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8 — Actualités -->
  <section class="latest" aria-labelledby="latest-title">
    <div class="wrap">
      <div class="latest__head ruled">
        <h2 class="h2" id="latest-title">Actualités</h2>
        <a class="link-arrow" href="/actualites">Toutes les actualités <Icon name="arrow" /></a>
      </div>
      <div class="latest__grid">
        <article class="latest__lead" data-reveal>
          <Picture src={photo(leadNews.image)} formats={['avif', 'webp']} widths={[640, 1000]} sizes="(min-width: 1024px) 58vw, 100vw" alt="" />
          <p class="latest__meta"><span>{leadNews.cat}</span> · <time datetime={leadNews.date}>{leadNews.dateLabel}</time></p>
          <h3 class="h3">{nb(leadNews.title)}</h3>
          <p class="latest__excerpt">{leadNews.excerpt}</p>
        </article>
        <div class="latest__side">
          {moreNews.slice(0, 3).map((n, i) => (
            <article class="latest__item" data-reveal style={`--d:${i * 0.06}s`}>
              <p class="latest__meta"><span>{n.cat}</span> · <time datetime={n.date}>{n.dateLabel}</time></p>
              <h3 class="latest__title">{nb(n.title)}</h3>
              <p class="latest__excerpt">{n.excerpt}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 9 — Galerie -->
  <section class="rail on-dark" aria-labelledby="rail-title" data-rail>
    <h2 class="visually-hidden" id="rail-title">Galerie</h2>
    <ul class="rail__track" data-rail-track tabindex="0" aria-label="Galerie — faire défiler horizontalement">
      {gallery.map((g) => (
        <li><Picture src={photo(g.image)} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 900px) 46vw, 84vw" alt={g.alt} /></li>
      ))}
    </ul>
    <div class="wrap rail__foot">
      <a class="link-arrow" href="/galerie">Voir toute la galerie <Icon name="arrow" /></a>
      <div class="rail__ctrl">
        <span class="num rail__count" data-rail-count aria-hidden="true">01 / {String(gallery.length).padStart(2, '0')}</span>
        <button class="icon-btn" type="button" data-rail-prev aria-label="Image précédente"><Icon name="prev" /></button>
        <button class="icon-btn" type="button" data-rail-next aria-label="Image suivante"><Icon name="next" /></button>
      </div>
    </div>
  </section>

  <!-- 10 — Appel -->
  <section class="call on-dark" aria-labelledby="call-title">
    <div class="call__media" aria-hidden="true">
      <Picture src={photo('assemblee-quartier')} formats={['avif', 'webp']} widths={[640, 1080]} sizes="100vw" alt="" />
    </div>
    <div class="wrap call__inner">
      <h2 class="call__title" id="call-title" data-reveal>{ctaBand.join(' ')}</h2>
      <div class="cluster" data-reveal style="--d:.12s">
        <a class="btn btn--signal" href="/contact">Je m'engage <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href="#restons-connectes">Rester informé(e)</a>
      </div>
    </div>
  </section>

  <Newsletter />
</Base>

<style>
  /* 1 — Hero */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; isolation: isolate; background: var(--navy-deep); color: #fff; }
  .hero__media { position: absolute; inset: 0; z-index: -2; }
  .hero__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 80% 30%; }
  .hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgba(0,12,40,.45) 0%, rgba(0,12,40,0) 20%),
      linear-gradient(0deg, rgba(0,12,40,.92) 0%, rgba(0,12,40,.5) 30%, rgba(0,12,40,0) 55%);
  }
  .hero__content { padding-bottom: clamp(2.25rem, 1.5rem + 3vw, 4.5rem); }
  .hero__title { font-family: var(--display); font-stretch: 72%; font-weight: 660; font-size: clamp(2.9rem, 1.6rem + 4.4vw, 5.6rem); line-height: .92; letter-spacing: -0.015em; max-width: 11ch; }
  @media (min-width: 900px) { .hero__title { max-width: none; } }
  .hero__status { margin-top: 1.25rem; font-family: var(--sans); font-size: clamp(1rem, .9rem + .4vw, 1.2rem); font-weight: 500; color: rgba(255,255,255,.92); }
  .hero__sign { margin-top: .5rem; font-style: italic; font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.6rem); line-height: 1.1; color: #fff; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; margin-top: 2rem; }
  .hero__link { font-family: var(--sans); font-weight: 600; text-decoration: none; border-bottom: 1.5px solid rgba(255,255,255,.6); padding-bottom: .2rem; }
  .hero__link:hover { border-color: #fff; }
  .btn--light { --bg: #fff; --fg: var(--navy); --bd: #fff; }
  .btn--light:hover { --bg: var(--paper); --bd: var(--paper); }

  @media (prefers-reduced-motion: no-preference) {
    .hero__media :global(img) { animation: settle 2s var(--ease) both; }
    .hero__content > * { animation: up 1.1s var(--ease) both; }
    .hero__content > :nth-child(2) { animation-delay: .12s; }
    .hero__content > :nth-child(3) { animation-delay: .2s; }
    .hero__content > :nth-child(4) { animation-delay: .3s; }
    @supports (animation-timeline: scroll()) {
      /* Rideau : la page glisse sur la photographie, qui s'assombrit et recule légèrement */
      .hero__media { animation: recede linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
      .hero__content { animation: fadeOut linear both; animation-timeline: scroll(root); animation-range: 0 70vh; }
    }
  }
  /* Tout ce qui suit le hero passe au-dessus de lui */
  @media (prefers-reduced-motion: no-preference) {
    .hero { position: sticky; top: 0; z-index: 0; }
    .hero ~ :global(*) { position: relative; z-index: 1; }
  }
  @keyframes settle { from { transform: scale(1.06); } to { transform: none; } }
  @keyframes up { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes recede { to { transform: scale(1.06); filter: brightness(.55); } }
  @keyframes fadeOut { to { opacity: 0; transform: translateY(-40px); } }

  /* 2 — Conviction */
  .conviction { padding-block: clamp(5rem, 3rem + 8vw, 11rem); background: var(--paper); }
  .conviction { box-shadow: 0 -30px 60px rgba(0,12,40,.25); }
  .conviction__fig { max-width: 26ch; font-size: clamp(1.9rem, 1rem + 3.4vw, 4.4rem); }
  .conviction blockquote p { font-style: italic; line-height: 1.16; letter-spacing: -0.01em; color: var(--navy); text-wrap: pretty; }
  .conviction figcaption { margin-top: 1.75rem; font-family: var(--sans); font-size: 1rem; font-weight: 600; color: var(--ink-2); }
  .conviction figcaption::before { content: '— '; color: var(--orange-ink); }
  .conviction__lines { margin-top: clamp(3rem, 2rem + 4vw, 6rem); display: grid; gap: 1.25rem; padding-top: 1.75rem; border-top: 4px solid var(--navy); font-family: var(--display); font-stretch: 80%; font-weight: 600; font-size: clamp(1.35rem, 1.05rem + 1vw, 1.9rem); line-height: 1.15; color: var(--navy); }
  @media (min-width: 900px) { .conviction__lines { grid-template-columns: 1fr 1fr; gap: var(--gutter); } }

  /* 3 — Bio */
  .bio { display: grid; background: var(--white); color: var(--ink); }
  .bio h2 { color: var(--navy); }
  .bio__media { overflow: hidden; }
  .bio__media :global(img) { width: 100%; height: 100%; min-height: 420px; max-height: 80svh; object-fit: cover; object-position: 30% 25%; }
  .bio__text { padding: clamp(3rem, 2rem + 4vw, 6.5rem) var(--gutter); display: grid; gap: 1.75rem; align-content: center; max-width: 720px; }
  .bio__prose { display: grid; gap: 1.1rem; color: var(--ink-2); }
  .bio__prose :global(strong) { color: var(--ink); }
  .bio__triad { font-family: var(--display); font-stretch: 74%; font-weight: 600; font-size: var(--fs-2xl); line-height: 1; letter-spacing: -0.01em; padding-block: 1.5rem; border-block: 1px solid var(--rule); color: var(--navy); }
  .bio .link-arrow { justify-self: start; }
  @media (min-width: 1024px) {
    .bio { grid-template-columns: 1fr 1fr; min-height: 88svh; }
    .bio__media { order: 2; }
    .bio__media :global(img) { max-height: none; }
    .bio__text { justify-self: end; padding-left: var(--gutter); padding-right: clamp(2rem, 1rem + 4vw, 6rem); }
  }

  /* 4 — Convictions */
  .beliefs { padding-block: var(--section); background: var(--navy-deep); color: #fff; }
  .beliefs__grid { display: grid; gap: 2.5rem var(--gutter); }
  .beliefs__title { max-width: 12ch; }
  .beliefs__list li {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.75rem); border-bottom: 1px solid var(--rule-light);
    font-family: var(--display); font-stretch: 76%; font-weight: 600; letter-spacing: -0.01em;
    font-size: clamp(1.7rem, 1.1rem + 2.4vw, 3.2rem); line-height: 1.04; text-wrap: balance;
  }
  .beliefs__list li:first-child { padding-top: 0; }
  @media (min-width: 1024px) {
    .beliefs__grid { grid-template-columns: 4fr 8fr; align-items: start; }
    .beliefs__title { position: sticky; top: calc(var(--header-h) + 2rem); }
  }

  /* 5 — Interlude */
  .interlude { height: max(240px, 62vw); overflow: hidden; position: relative; background: var(--navy-deep); }
  @media (min-width: 900px) { .interlude { height: clamp(420px, 78svh, 820px); } }
  .interlude__media { position: absolute; inset: -12% 0; }
  .interlude__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 60% 40%; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .interlude__media { animation: parallax linear both; animation-timeline: view(); }
    }
  }
  @keyframes parallax { from { transform: translateY(-4%); } to { transform: translateY(4%); } }

  /* 6 — Boussole : rangée typographique */
  .compass { padding-block: var(--section) clamp(3rem, 2rem + 3vw, 5rem); background: var(--paper); }
  .compass__title { font-family: var(--serif); font-style: italic; font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.2rem); color: var(--ink-2); margin-bottom: 2rem; }
  .compass__row { display: grid; gap: 0 var(--gutter); }
  .compass__row li {
    padding: 1.5rem 0 2rem; border-top: 4px solid var(--navy);
    font-family: var(--display); font-stretch: 78%; font-weight: 620; font-size: clamp(1.5rem, 1.1rem + 1.3vw, 2.3rem); line-height: 1.05; color: var(--navy); text-wrap: balance;
  }
  .compass__row li::first-letter { text-transform: uppercase; }
  @media (min-width: 720px) { .compass__row { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .compass__row { grid-template-columns: repeat(4, 1fr); } }

  /* 6b — Méthode : parcours horizontal */
  .method { padding-block: clamp(3rem, 2rem + 3vw, 5rem) var(--section); background: var(--paper); }
  .method__head { display: grid; gap: 1rem; margin-bottom: 2.5rem; }
  .method__head h2 { color: var(--navy); max-width: 18ch; }
  .method__head p { color: var(--ink-3); }
  .method__path { display: grid; gap: 0; }
  .method__path li { position: relative; padding: 1.1rem 0 1.1rem 2rem; border-left: 1px solid var(--rule-strong); font-size: var(--fs-lg); color: var(--ink); }
  .method__path li::before { content: ''; position: absolute; left: -5px; top: 1.55rem; width: 9px; height: 9px; border-radius: 50%; background: var(--orange); }
  .method__more { margin-top: 2.5rem; }
  @media (min-width: 1024px) {
    .method__path { grid-template-columns: repeat(5, 1fr); gap: var(--gutter); border-top: 1px solid var(--rule-strong); }
    .method__path li { border-left: 0; padding: 2rem 0 0; font-size: 1.3rem; line-height: 1.35; }
    .method__path li::before { left: 0; top: -5px; }
  }

  /* 7 — Pivots */
  .pivots { padding-block: 0 var(--section); background: var(--paper); }
  .pivots__grid { display: grid; }
  .pivots__panel { background: var(--navy); color: #fff; padding: clamp(2rem, 1.5rem + 3vw, 4rem); display: grid; gap: 1.5rem; align-content: start; }
  .pivots__panel p { color: rgba(255,255,255,.86); max-width: 40ch; }
  .pivots__panel .link-arrow { justify-self: start; }
  .pivots__list { background: var(--white); padding: clamp(.5rem, .25rem + 1vw, 1.5rem) clamp(1.25rem, 1rem + 2vw, 3rem); }
  .pivots__list a {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-block: 1.05rem;
    border-bottom: 1px solid var(--rule); text-decoration: none; font-family: var(--display); font-stretch: 82%; font-weight: 580; font-size: clamp(1.1rem, 1rem + .5vw, 1.35rem); color: var(--navy);
    transition: color .25s, padding .35s var(--ease);
  }
  .pivots__list li:last-child a { border-bottom: 0; }
  .pivots__list a :global(svg) { width: 20px; height: 20px; flex: none; color: var(--orange-ink); transition: transform .35s var(--ease); }
  .pivots__list a:hover { color: var(--orange-ink); padding-left: .35rem; }
  .pivots__list a:hover :global(svg) { transform: translateX(4px); }
  @media (min-width: 1024px) {
    .pivots__grid { grid-template-columns: 5fr 7fr; }
    .pivots__list { columns: 2; column-gap: 2.5rem; }
    .pivots__list li { break-inside: avoid; }
    .pivots__list li:nth-child(4) a { border-bottom: 0; }
  }

  /* 8 — Actualités */
  .latest { padding-block: var(--section); background: var(--white); }
  .latest__head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.5rem; color: var(--navy); }
  .latest__grid { display: grid; gap: 2.5rem var(--gutter); }
  .latest__lead :global(img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; margin-bottom: 1.25rem; }
  .latest__lead .h3 { color: var(--navy); font-size: var(--fs-2xl); }
  .latest__meta { font-family: var(--sans); font-size: .85rem; color: var(--ink-3); margin-bottom: .6rem; }
  .latest__meta span { color: var(--orange-ink); font-weight: 600; }
  .latest__excerpt { margin-top: .6rem; color: var(--ink-2); }
  .latest__side { display: grid; align-content: start; }
  .latest__item { padding-block: 1.5rem; border-top: 1px solid var(--rule); }
  .latest__item:first-child { border-top: 0; padding-top: 0; }
  .latest__title { font-family: var(--display); font-stretch: 80%; font-weight: 620; font-size: 1.45rem; line-height: 1.1; color: var(--navy); }
  @media (min-width: 1024px) { .latest__grid { grid-template-columns: 7fr 5fr; } }

  /* 9 — Rail */
  .rail { background: var(--navy-deep); color: #fff; padding-block: clamp(3rem, 2rem + 4vw, 6rem); }
  .rail__track {
    display: flex; gap: clamp(.75rem, .5rem + 1vw, 1.5rem); overflow-x: auto; scroll-snap-type: x mandatory;
    padding-inline: max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter)));
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter)));
    scrollbar-width: none;
  }
  .rail__track::-webkit-scrollbar { display: none; }
  .rail__track li { flex: none; scroll-snap-align: start; height: clamp(300px, 62svh, 640px); }
  .rail__track :global(img) { height: 100%; width: auto; max-width: none; object-fit: cover; }
  .rail__foot { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 1.75rem; }
  .rail__ctrl { display: flex; align-items: center; gap: .75rem; }
  .rail__count { font-family: var(--sans); font-size: .9rem; margin-right: .5rem; color: rgba(255,255,255,.82); }

  /* 10 — Appel */
  .call { position: relative; isolation: isolate; color: #fff; overflow: hidden; }
  .call__media { position: absolute; inset: 0; z-index: -2; }
  .call__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .call::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(0,12,40,.9) 0%, rgba(0,12,40,.7) 45%, rgba(0,12,40,.2) 100%); }
  .call__inner { padding-block: clamp(6rem, 4rem + 8vw, 11rem); display: grid; gap: 2.5rem; }
  .call__title { font-family: var(--display); font-stretch: 72%; font-weight: 640; font-size: clamp(2.2rem, 1.2rem + 3.6vw, 4.8rem); line-height: .98; letter-spacing: -0.012em; max-width: 18ch; text-wrap: balance; }
</style>
