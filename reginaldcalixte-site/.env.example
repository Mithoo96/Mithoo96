# Variables des fonctions /api (à définir dans Vercel → Settings → Environment Variables)
RESEND_API_KEY=            # clé API Resend (obligatoire pour l'envoi)
MAIL_FROM=Site Réginald Calixte <site@reginaldcalixte.com>   # expéditeur sur un domaine vérifié dans Resend
CONTACT_TO=annpale@reginaldcalixte.com                       # destinataire des messages
RESEND_AUDIENCE_ID=        # facultatif : audience Resend pour la liste « Restons connectés »
ALLOWED_ORIGINS=reginaldcalixte.com,www.reginaldcalixte.com  # origines autorisées à appeler /api
VERCEL_PREVIEW_PREFIX=reginaldcalixte                        # préfixe des URL de prévisualisation Vercel autorisées
